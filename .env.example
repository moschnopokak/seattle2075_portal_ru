# Домен портала (A-запись должна указывать на IP сервера)
DOMAIN=portal.example.ru
SITE_URL=https://portal.example.ru

# Бот из @BotFather: токен и имя без @
BOT_TOKEN=
BOT_USERNAME=

# Чат стола для закреплённого статуса (число, у групп начинается с минуса). Пусто, если не нужно.
TG_CHAT_ID=

# Личные уведомления от бота: 1 включены, 0 выключены
NOTIFY_DM=1

# Часовой пояс по умолчанию для тихих часов и сводки (каждый игрок может выбрать свой в «Уведомления»), например Europe/Moscow
DEFAULT_TZ=Europe/Moscow

# Через сколько секунд после первого нового сообщения в обсуждении записи уходит одно уведомление «N новых сообщений»
CHAT_NOTIFY_DELAY=300

# Кнопки «Принять / Отклонить» прямо в сообщениях бота: 1 включить. Нужен SITE_URL с https://.
# Пока включено, у этого бота не работает getUpdates (им узнают ID чата стола: сначала узнайте его, потом включайте).
TG_WEBHOOK=0

# Напоминание о приглашении без ответа: через сколько дней (от приглашения или прошлого напоминания) и сколько раз всего.
# REMIND_DAYS=0 выключает напоминания для всех
REMIND_DAYS=2
REMIND_MAX=2

# Фоновый планировщик: очередь уведомлений, уборка корзины и журнала. 1 включён (так и оставьте), 0 только для тестов
SCHEDULER=1

# Картинки досье: общий лимит хранилища и максимальный размер загружаемого файла, МБ
PORTRAIT_QUOTA_MB=40
PORTRAIT_MAX_UPLOAD_MB=8

# Отправлять каждую резервную копию мастеру в личные сообщения от бота: 1 да, 0 нет.
# Нужны BOT_TOKEN и Telegram ID мастера в players.toml; мастер должен один раз нажать «Запустить» у бота.
BACKUP_TELEGRAM=0

# Пульс резервных копий: адрес проверки с healthchecks.io (или своего сервера healthchecks), например
# https://hc-ping.com/ваш-uuid . После каждой копии туда уходит сигнал; если сигнала нет, сервис пишет вам.
HEALTHCHECKS_URL=

# Сколько дней хранятся удалённые записи и карточки в корзине и сколько записи журнала изменений
TRASH_DAYS=30
AUDIT_DAYS=365

# Пересказ «Что было раньше» (Claude API). Пока ключ пустой, функции нет и ничего никуда не отправляется.
# Ключ создаётся на https://console.anthropic.com/ (раздел API keys). В Anthropic уходит текст хроники, сведений и раздаток,
# которые видит сам игрок, больше ничего. Один пересказ стоит порядка 10 центов на модели по умолчанию.
ANTHROPIC_API_KEY=
# 0 выключает пересказ, даже если ключ задан
# RECAP=1
# Пересказ без ключа и без оплаты, «через мастера» (RECAP_MODE=gm). Игрок нажимает «Что было раньше», портал собирает запрос
# (только то, что видит этот игрок) и кладёт его в панель мастера. Вы копируете запрос в свой обычный чат с Claude, а ответ вставляете
# обратно, и игрок получает пересказ. Тратятся лимиты вашей подписки, ключ не нужен и никуда ничего не отправляется.
# Если ключ тоже задан, в этом режиме он не используется.
# RECAP_MODE=gm
# Модель и глубина размышления (low, medium, high). Для пересказа хватает low
# RECAP_MODEL=claude-opus-5-5
# RECAP_EFFORT=low
# Сколько новых пересказов в сутки может заказать один игрок и весь портал (повторный запрос того же берётся из памяти бесплатно)
# RECAP_PER_DAY=6
# RECAP_DAILY_TOTAL=40

# Раздатки (HTML, картинки, PDF, аудио): общий лимит хранилища (в том виде, как лежит в базе) и максимальный размер одного файла, МБ.
# Для длинных аудиозаписей поднимите HANDOUT_MAX_UPLOAD_MB (и client_max_body_size в nginx)
HANDOUT_QUOTA_MB=100
HANDOUT_MAX_UPLOAD_MB=15

# Сколько дней действует вход (по умолчанию 30)
# SESSION_DAYS=30

# Ключ подписи сессий. Пусто: создастся сам в data/secret.key
SECRET_KEY=

# Политика безопасности содержимого (CSP) для страницы портала:
#   report-only  только сообщает о нарушениях в журнал (строки «CSP: …»), ничего не блокирует (по умолчанию)
#   enforce      блокирует всё, что политика не разрешает; включайте, когда в журнале неделю нет нарушений
#   off          выключена
CSP_MODE=report-only

# Как кнопка входа Telegram возвращает результат на сайт: redirect (по умолчанию, работает со строгим CSP)
# или callback (прежний способ; если вход в браузере вдруг не работает, поставьте callback)
TG_WIDGET_MODE=redirect

# Только для проверки без Telegram на своём компьютере. Если задан BOT_TOKEN, портал считает себя рабочим
# сервером и игнорирует DEV_LOGIN=1 (в журнале будет ошибка).
DEV_LOGIN=0
COOKIE_SECURE=1
