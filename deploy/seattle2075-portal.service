# Вариант без Docker: sudo cp deploy/seattle2075-portal.service /etc/systemd/system/
[Unit]
Description=Seattle 2075 campaign portal
After=network.target

[Service]
User=portal
WorkingDirectory=/opt/seattle2075-portal
EnvironmentFile=/opt/seattle2075-portal/.env
ExecStart=/opt/seattle2075-portal/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000 --proxy-headers
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
