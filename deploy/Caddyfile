{$DOMAIN} {
	encode zstd gzip

	# Браузер целый год ходит на сайт только по https. Чтобы отменить, верните max-age=0 и подождите, пока браузеры обновятся.
	header {
		Strict-Transport-Security "max-age=31536000"
		-Server
	}

	# Самый большой файл, который принимает портал, это раздатка (HANDOUT_MAX_UPLOAD_MB, по умолчанию 15 МБ).
	# Если увеличиваете лимит в .env, увеличьте и это число.
	request_body {
		max_size 16MB
	}

	reverse_proxy app:8000
}

# Адрес с www перекидывает на основной. Если у домена нет записи www, удалите этот блок:
# иначе Caddy будет безуспешно пытаться получить для него сертификат.
www.{$DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}
